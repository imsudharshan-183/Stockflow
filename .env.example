# StockFlow. Copy to a repo-root .env for local overrides.
# Do not commit .env. On Vercel, set MONGODB_URI in the project environment.
# With no URI the API uses the in-memory seed on localhost:3001.

PORT=3001
HOST=127.0.0.1

# Leave empty for the in-memory repository. Set to use the stockflow database.
MONGODB_URI=

# Authentication and RBAC
AUTH_ENABLED=false
JWT_SECRET=dev-secret-change-in-production-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ADMIN_PASSWORD=Admin@12345

