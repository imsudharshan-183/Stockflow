# StockFlow. Copy to a repo-root .env for local overrides.
# Do not commit .env. On Vercel, set MONGODB_URI in the project environment.
# With no URI the API uses the in-memory seed on localhost:3001.

PORT=3001
HOST=127.0.0.1

# Leave empty for the in-memory repository. Set to use the stockflow database.
MONGODB_URI=

# Authentication and RBAC
AUTH_ENABLED=false
# Set true on the admin demo API to allow one simulated sales day per Bahrain calendar day.
ALLOW_SYNTHETIC_DATA=false
JWT_SECRET=dev-secret-change-in-production-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ADMIN_PASSWORD=Admin@12345

# Optional comma-separated allowed CORS origins for cross-origin production deployments.
# Leave empty when web and api are served on the same origin via Vercel Services.
WEB_ORIGIN=


# Optional server-side OpenAI summaries. Remove the leading # and enter your key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional Google AI Studio provider (server only).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
